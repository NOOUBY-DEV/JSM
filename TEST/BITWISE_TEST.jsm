SET RG1 123;


CMPTR RG1;
JUMP 4;
EXIT 0;
SET RG1 0;

SET RG2 12;
AND RG2 5;    // EXPECT 4
ADD RG1 RG2;

SET RG2 12;
OR  RG2 5;    // EXPECT 13
ADD RG1 RG2;

SET RG2 12;
XOR RG2 25;   // EXPECT 21 
ADD RG1 RG2;

SET RG2 5;
SHL RG2 1;
ADD RG1 RG2;  // EXPECT 10


EXIT RG1;     // EXPECT 48 = 4 + 13 + 21 + 10

END;
