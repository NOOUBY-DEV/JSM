PUSHQ    0;

PUSHQ    10;

PUSHQ    10;

PUSHQ    10;

PUSHQ    0;


RLOADQ   RG1 0;
CMPE     RG1 100000000;


JUMP     20;


RLOADQ   RG1 8;
SET      RA1 RG1;
RLOADQ   RG1 16;
SET      RA2 RG1;
RLOADQ   RG1 24;
SET      RA3 RG1;
CALL     22;
RWRITEQ  RRV 32;


RLOADQ   RG1 0;
INC      RG1;
RWRITEQ  RG1 0;


JUMP 5;


RLOADQ   RG1 32;
EXIT     RG1;


PUSHQ    0;


SET      RG1 0;
ADD      RG1 RA1;
ADD      RG1 RA2;
ADD      RG1 RA3;
RWRITEQ  RG1 0;


RLOADQ   RG1 0;
SET      RRV RG1;
RETURN;


END;
