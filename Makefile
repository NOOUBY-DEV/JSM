C_FLAGS = -I./JSM
GCC_FLAGS = -g -O3
# -DUNFETTERED
#-Ofast



OUTPUT_FOLDER = OUTPUT
ALL_C_FILES = $(shell find JSM -name "*.c")
JSM_SOURCE_FILES = $(filter-out JSM/SOURCE/PROGRAMS/%, $(ALL_C_FILES))



.PHONY: JSMC_PROGRAM_FILE

JSMC_PROGRAM_FILE = JSM/SOURCE/PROGRAMS/JSMC_PROGRAM.c
JRM_PROGRAM_FILE = JSM/SOURCE/PROGRAMS/JRM_PROGRAM.c
JSMC_PROGRAM_FILE: $(JSMC_PROGRAM_FILE)
	mkdir -p $(OUTPUT_FOLDER)
	gcc $(GCC_FLAGS) $(JSM_SOURCE_FILES) $(JSMC_PROGRAM_FILE) $(C_FLAGS) -o $(OUTPUT_FOLDER)/JSMC
	gcc $(GCC_FLAGS) $(JSM_SOURCE_FILES) $(JRM_PROGRAM_FILE) $(C_FLAGS) -o $(OUTPUT_FOLDER)/JRM



ARGS = $(filter-out $@,$(MAKECMDGOALS))



RUN:
	clear
	./$(OUTPUT_FOLDER)/$(P) $(ARGS)


%.jsm: FORCE
	@:

%.jrp: FORCE
	@:

FORCE:


JSMC:
	@clear
	@./$(OUTPUT_FOLDER)/JSMC $(ARGS)


LAZYCOMP:
	@clear
	@./$(OUTPUT_FOLDER)/JSMC TEST/$(ARGS).jsm COMPILED_JRPS/$(ARGS).jrp


LAZYRUN:
	@clear
	@./$(OUTPUT_FOLDER)/JRM COMPILED_JRPS/$(ARGS)



JRM:
	@clear
	@./$(OUTPUT_FOLDER)/JRM $(ARGS)



GET_JRM_ASM:
	@clear
	@gcc -S -O2 -g -fverbose-asm JSM/SOURCE/JRM.c -o JRM.s
